# URL base de la API. En desarrollo se usa el proxy de Vite (/api),
# por eso puede quedar vacío. En producción, apunta al backend real:
#   VITE_API_URL=https://api.tu-dominio.pe/api
VITE_API_URL=/api

# Modo de firma con ReFirma: "true" simula la firma (sin lector de DNIe).
# Cambia a "false" solo en la PC que tenga el ReFirma Invoker real instalado.
VITE_REFIRMA_DEMO_MODE=true
