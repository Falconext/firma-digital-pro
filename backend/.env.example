# ==========================================================================
#  Firma Digital Pro — Variables de entorno del BACKEND
#  Copia este archivo como ".env" y ajusta los valores.
# ==========================================================================

# Puerto en el que corre la API
PORT=3000

# Prefijo global de la API (todas las rutas empiezan con esto)
API_PREFIX=api

# Origen(es) permitidos para CORS (el frontend). Separar por comas si son varios.
# En producción: la URL del frontend en Vercel, ej. https://firma.vercel.app
CORS_ORIGIN=http://localhost:5173

# Base pública de la URL de verificación que va en el QR de los PDFs.
# Vacío = se deduce de cada request. En producción conviene fijarla:
#   VERIFY_URL_BASE=https://tu-backend.up.railway.app/api/verificar
VERIFY_URL_BASE=

# --------------------------------------------------------------------------
#  Base de datos (Prisma) — PostgreSQL.
#  En Railway la variable la inyecta el servicio Postgres (${{Postgres.DATABASE_URL}}).
#  En local puedes usar la URL pública de esa misma base (Railway > Postgres >
#  Variables > DATABASE_PUBLIC_URL) o un Postgres propio con Docker.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@localhost:5432/firma_digital?schema=public"

# --------------------------------------------------------------------------
#  Seguridad / JWT
#  CAMBIA estos valores en producción por cadenas largas y aleatorias.
# --------------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=cambia-esto-tambien-por-otro-secreto
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------------------------
#  Almacenamiento de archivos
#  Carpeta donde se guardan los PDFs subidos y firmados.
# --------------------------------------------------------------------------
STORAGE_DIR=./storage

# --------------------------------------------------------------------------
#  Usuario administrador que crea el "seed" (datos iniciales)
# --------------------------------------------------------------------------
ADMIN_EMAIL=admin@firmadigital.pe
ADMIN_PASSWORD=Admin123!

# --------------------------------------------------------------------------
#  Correo (Resend) — paso 6.7: enviar el documento firmado al cliente.
#  Crea tu API key en https://resend.com y verifica tu dominio de envío.
# --------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tu-dominio.pe

# --------------------------------------------------------------------------
#  Amazon S3 — almacenamiento de PDFs (bucket público de lectura)
#  Si dejas estas variables vacías, se usará el disco local (STORAGE_DIR).
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=nexara-firma-digital

# --------------------------------------------------------------------------
#  Datos de la empresa emisora (cabecera de las cotizaciones en PDF)
# --------------------------------------------------------------------------
EMPRESA_NOMBRE=Certificaciones Nacionales de Alimentos S.A.C.
EMPRESA_RUC=
EMPRESA_DIRECCION=Huancayo, Junín, Perú
EMPRESA_TELEFONO=
EMPRESA_EMAIL=
EMPRESA_WEB=www.cenasaclab.com

# --------------------------------------------------------------------------
#  Consulta RENIEC / SUNAT (apiperu.dev) para autocompletar clientes y firmantes.
#  Crea tu token en https://apiperu.dev. Vacío = la consulta queda deshabilitada.
# --------------------------------------------------------------------------
RENIEC_TOKEN=

# --------------------------------------------------------------------------
#  Formato de cotización: logo, cuentas bancarias, atención al cliente, cláusulas
# --------------------------------------------------------------------------
EMPRESA_LOGO=./assets/logo.png
# Cuentas para el pago del servicio, separadas por "|"
EMPRESA_CUENTAS=Cuenta corriente Banco BBVA Perú |Cuenta corriente Banco de Crédito del Perú 
EMPRESA_CUENTA_DETRACCION=Cuenta del Banco de la Nación 
ATENCION_CONTACTO=(nombre del responsable de atención al cliente)
ATENCION_CORREO=atencionalcliente@cenasaclab.com
ATENCION_CELULAR=(celular)
COTIZACION_CLAUSULAS=Se adjunta Anexo N° 01 Cláusulas para el desarrollo del Servicio, la notificación puede ser aprobada.
